"dim_campaign\", \"schema\": \"marketing_ads_staging\", \"status\": \"success\", \"execution_time\": 8.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH campaigns AS (\\n\\n    SELECT DISTINCT platform,campaign_id,campaign_name\\n    FROM `bronze_staging`.`marketing_ads_staging`.`int_marketing_ads`\\n\\n    WHERE campaign_id IS NOT NULL\\n)\\n\\n\\nSELECT \\nmd5(cast(concat(coalesce(cast(platform as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(campaign_id as string), '_dbt_utils_surrogate_key_null_')) as string)) AS campaign_key,\\n    platform,\\n    campaign_id,\\n    campaign_name\\nFROM campaigns\", \"generated_at\": \"2026-10-31 23:06:03\"}, {\"unique_id\": \"model.marketing_data_platform.fct_marketing_spend\", \"invocation_id\": \"54789b0d-6a92-4141-918d-02f4df1a4e44\", \"name\": \"fct_marketing_spend\", \"schema\": \"marketing_ads_staging\", \"status\": \"success\", \"execution_time\": 8.4, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"SELECT\\n    ad_daily_key,\\n    md5(cast(concat(coalesce(cast(platform as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(campaign_id as string), '_dbt_utils_surrogate_key_null_')) as string)) AS campaign_key,\\n    platform,\\n    report_date,\\n    ad_id,\\n    campaign_id,\\n    campaign_name,\\n    currency_code,\\n    spend,\\n    impressions,\\n    clicks,\\n    is_clicks_reported,\\n    \\n    CASE\\n        WHEN impressions IS NULL OR impressions = 0 THEN NULL\\n        ELSE clicks / impressions\\n    END\\n AS ctr,\\n    \\n    CASE\\n        WHEN clicks IS NULL OR clicks = 0 THEN NULL\\n        ELSE spend / clicks\\n    END\\n AS cpc,\\n    \\n    CASE\\n        WHEN impressions IS NULL OR impressions = 0 THEN NULL\\n        ELSE spend * 1000 / impressions\\n    END\\n AS cpm\\nFROM `bronze_staging`.`marketing_ads_staging`.`int_marketing_ads`\", \"generated_at\": \"2026-10-31 23:06:03\"}, {\"unique_id\": \"model.marketing_data_platform.int_facebook_ads_daily\", \"invocation_id\": \"54789b0d-6a92-4141-918d-02f4df1a4e44\", \"name\": \"int_facebook_ads_daily\", \"schema\": \"marketing_ads_staging\", \"status\": \"success\", \"execution_time\": 2.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH stats AS (\\n\\n    SELECT * FROM `bronze_staging`.`marketing_ads_staging`.`stg_facebook_ads_stats`\\n\\n),\\n\\nads AS (\\n\\n    SELECT ad_id, campaign_id FROM `bronze_staging`.`marketing_ads_staging`.`stg_facebook_ads`\\n\\n),\\n\\ncampaigns AS (\\n\\n    SELECT campaign_id, campaign_name FROM `bronze_staging`.`marketing_ads_staging`.`stg_facebook_campaign`\\n\\n),\\n\\naccounts AS (\\n\\n    SELECT account_id, ad_currency_code FROM `bronze_staging`.`marketing_ads_staging`.`stg_facebook_account`\\n\\n)\\n\\nSELECT\\n    'facebook' AS platform,\\n    stats.ad_id,\\n    stats.report_date,\\n    ads.campaign_id,\\n    campaigns.campaign_name,\\n    accounts.ad_currency_code AS currency_code,\\n    CAST(stats.spend AS DECIMAL(18, 6)) AS spend,\\n    stats.impressions,\\n    stats.clicks,\\n    stats.clicks IS NOT NULL AS is_clicks_reported\\nFROM stats\\nLEFT JOIN ads ON stats.ad_id = ads.ad_id\\nLEFT JOIN campaigns ON ads.campaign_id = campaigns.campaign_id\\nLEFT JOIN accounts ON stats.account_id = accounts.account_id\", \"generated_at\": \"2026-10-31 23:06:03\"}, {\"unique_id\": \"model.marketing_data_platform.int_marketing_ads\", \"invocation_id\": \"54789b0d-6a92-4141-918d-02f4df1a4e44\", \"name\": \"int_marketing_ads\", \"schema\": \"marketing_ads_staging\", \"status\": \"success\", \"execution_time\": 6.1, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH unioned AS (\\n\\n    SELECT * FROM `bronze_staging`.`marketing_ads_staging`.`int_facebook_ads_daily`\\n    UNION ALL\\n    SELECT * FROM `bronze_staging`.`marketing_ads_staging`.`int_snapchat_ads_daily`\\n\\n)\\n\\nSELECT\\n    md5(cast(concat(coalesce(cast(platform as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(ad_id as string), '_dbt_utils_surrogate_key_null_'), '-', coalesce(cast(report_date as string), '_dbt_utils_surrogate_key_null_')) as string)) AS ad_daily_key,\\n    *\\nFROM unioned\", \"generated_at\": \"2026-10-31 23:06:03\"}, {\"unique_id\": \"model.marketing_data_platform.int_snapchat_ads_daily\", \"invocation_id\": \"54789b0d-6a92-4141-918d-02f4df1a4e44\", \"name\": \"int_snapchat_ads_daily\", \"schema\": \"marketing_ads_staging\", \"status\": \"success\", \"execution_time\": 2.7, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH stats_by_day AS (\\n\\n    SELECT\\n        ad_id,\\n        report_date,\\n        currency_code,\\n        SUM(spend) AS spend,\\n        SUM(impressions) AS impressions,\\n        SUM(clicks) AS clicks,\\n        COUNT(clicks) = COUNT(*) AS is_clicks_reported\\n    FROM `bronze_staging`.`marketing_ads_staging`.`stg_snapchat_ads_stats`\\n    GROUP BY ad_id, report_date, currency_code\\n\\n),\\n\\nads AS (\\n\\n    SELECT ad_id, ad_group_id FROM `bronze_staging`.`marketing_ads_staging`.`stg_snapchat_ad_history`\\n\\n),\\n\\nad_groups AS (\\n\\n    SELECT ad_group_id, campaign_id FROM `bronze_staging`.`marketing_ads_staging`.`stg_snapchat_ad_group`\\n\\n),\\n\\ncampaigns AS (\\n\\n    SELECT campaign_id, campaign_name FROM `bronze_staging`.`marketing_ads_staging`.`stg_snapchat_ads_campaign`\\n\\n)\\n\\nSELECT\\n    'snapchat' AS platform,\\n    stats_by_day.ad_id,\\n    stats_by_day.report_date,\\n    ad_groups.campaign_id,\\n    campaigns.campaign_name,\\n    stats_by_day.currency_code,\\n    CAST(stats_by_day.spend AS DECIMAL(18, 6)) AS spend,\\n    stats_by_day.impressions,\\n    stats_by_day.clicks,\\n    stats_by_day.is_clicks_reported\\nFROM stats_by_day\\nLEFT JOIN ads ON stats_by_day.ad_id = ads.ad_id\\nLEFT JOIN ad_groups ON ads.ad_group_id = ad_groups.ad_group_id\\nLEFT JOIN campaigns ON ad_groups.campaign_id = campaigns.campaign_id\", \"generated_at\": \"2026-10-31 23:06:03\"}, {\"unique_id\": \"model.marketing_data_platform.stg_facebook_account\", \"invocation_id\": \"54789b0d-6a92-4141-918d-02f4df1a4e44\", \"name\": \"stg_facebook_account\", \"schema\": \"marketing_ads_staging\", \"status\": \"success\", \"execution_time\": 4.1, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH source_data as (\\n\\n    SELECT * FROM `bronze_staging`.`marketing_ads_staging`.`facebook_account` \\n\\n--     \\n\\n--         limit 1000\\n\\n--     \\n\\n-- \\n),\\n\\n\\nformatted AS (\\n\\n    SELECT \\n\\n\\n        CAST(account_id AS STRING) AS account_id,\\n\\n        CAST(account_name AS STRING) AS account_name,\\n        CAST(ad_currency_code AS STRING) AS ad_currency_code,\\n\\n        CAST(account_created_at AS TIMESTAMP) AS account_created_at,\\n        CAST(account_updated_at AS TIMESTAMP) AS account_updated_at\\n\\n    FROM\\n        source_data\\n)\\n\\nSELECT * FROM formatted\", \"generated_at\": \"2026-10-31 23:06:03\"}, {\"unique_id\": \"model.marketing_data_platform.stg_facebook_ads\", \"invocation_id\": \"54789b0d-6a92-4141-918d-02f4df1a4e44\", \"name\": \"stg_facebook_ads\", \"schema\": \"marketing_ads_staging\", \"status\": \"success\", \"execution_time\": 4.2, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"WITH source_data AS (\\n\\n    SELECT * FROM `bronze_staging`.`marketing_ads_staging`.`facebook_ads`\\n\\n    \\n\\n--     \\n\\n--         limit 1000\\n\\n--     \\n\\n-- \\n),\\n\\nformatted AS (\\n\\n    SELECT\\n        CAST(ad_id AS STRING) AS ad_id,\\n        CAST(campaign_id AS STRING) AS campaign_id,\\n        CAST(ad_group_id AS STRING) AS ad_group_id,\\n        CAST(account_id AS STRING) AS account_id,\\n        CAST(ad_name AS STRING) AS ad_name,\\n        UPPER(CAST(ad_status AS STRING)) AS ad_status,\\n        CAST(ad_updated_at AS TIMESTAMP) AS ad_updated_at\\n    FROM source_data\\n\\n)\\n\\nSELECT * FROM formatt